# SQLite is the default for local development.
DB_MODE=sqlite
DB_PATH=data/sepa.db

# For Neon/PostgreSQL set DB_MODE=postgres and DATABASE_URL.
# Do not put a real connection URL in this file or commit it.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# CKAN is public and does not require an API key. Set this only if the
# configured API requires authentication.
# CKAN_API_KEY=

# Weekly capture: Monday at 14:00 Buenos Aires time.
RUN_AT=14:00
RUN_TIMEZONE=America/Argentina/Buenos_Aires
